# ==============================================================================
# NexusPlay Gaming Platform — Environment Configuration Template
# Copy to .env and configure for local or staging environments.
# NEVER commit .env files containing real secrets to source control.
# ==============================================================================

# Node Environment: development | staging | production
NODE_ENV=development

# Server Port
PORT=5050

# Internal QA Access Key for Non-Production Outbox Inspection
# In production, the outbox endpoint is permanently disabled (HTTP 404).
# In staging/dev, generate a 64-character random hex string for authorized testing personnel.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TEST_KEY=

# Trusted Reverse Proxy IP addresses or CIDR blocks (comma-separated)
# Only requests originating from these IP addresses will have their X-Forwarded-Proto
# and X-Forwarded-For headers respected. Direct client spoofing from untrusted IPs is ignored.
# Default: 127.0.0.1, ::1, ::ffff:127.0.0.1
TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1

# Session Security Configuration
# 24 hours in milliseconds: 86400000
SESSION_MAX_AGE_MS=86400000
